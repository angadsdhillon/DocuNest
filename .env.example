# Phase 0/1 — Auth & Database (Supabase)
# The web app needs only the first two plus NEXT_PUBLIC_APP_URL. The service
# role key is for the worker and migrations only — never import it in apps/web.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Used from Phase 1 onwards to build the email-confirmation link
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 2 — File Storage (Cloudflare R2)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=docunest-documents
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
DOCUMENT_ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Phase 3 — AI Classification
OPENAI_API_KEY=sk-...
# Cheapest current OpenAI "nano"-tier model. Change here, not in code, if
# pricing/models shift later.
OPENAI_CLASSIFICATION_MODEL=gpt-5-nano

# Phase 3 — Job Queue (Upstash Redis)
# BullMQ needs a real Redis (RESP) connection, which apps/worker derives
# from these same two values (the REST token doubles as the RESP
# password) — see packages/queue/src/connection.ts. No extra vars needed.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Phase 3 — Virus scanning (ClamAV `clamd` daemon, run as a sidecar next to
# the worker; see the worker's README for the local-dev caveat)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_ENABLED=true

# Phase 3 — apps/worker only, never apps/web. How many document-processing
# jobs the worker handles at once.
WORKER_CONCURRENCY=3

# Phase 4 — Inbound Email
INBOUND_EMAIL_DOMAIN=inbound.example.com
INBOUND_WORKER_SHARED_SECRET=replace_with_long_random_secret

# Phase 5 — Billing (Stripe)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...

# Phase 8 — Observability
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/0
